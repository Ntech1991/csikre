<Window x:Class="Ntech.AI.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ntech.AI.Desktop"
        mc:Ignorable="d"
        Title="Ntech AI Assistant" Height="700" Width="1000"
        Background="#F5F5F5"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:RoleColorConverter x:Key="RoleColorConverter"/>
        <local:InvertBoolConverter x:Key="InvertBoolConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <StackPanel Grid.Column="0" Background="#2C3E50">
            <TextBlock Text="Ntech AI" Foreground="White" FontSize="24" FontWeight="Bold" Margin="15,15,15,20"/>
            <Button Content="+ New Chat" Background="#3498DB" Foreground="White" Padding="10" Margin="15,0,15,10"
                    Command="{Binding NewChatCommand}"/>
            <TextBlock Text="Powered by Ollama" Foreground="#95A5A6" FontSize="10" Margin="15,20,15,15"/>
        </StackPanel>

        <!-- Chat Area -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Chat Messages -->
            <ListBox Grid.Row="0" Background="White" Margin="0,0,0,15" 
                     ItemsSource="{Binding Messages}" 
                     BorderBrush="#BDC3C7" BorderThickness="1" Padding="10">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,5,0,5">
                            <TextBlock FontWeight="Bold" 
                                       Foreground="{Binding Role, Converter={StaticResource RoleColorConverter}}">
                                <Run Text="{Binding Role}"/> 
                            </TextBlock>
                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" 
                                       Foreground="#2C3E50" Margin="10,0,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Loading Indicator -->
            <TextBlock Grid.Row="0" Text="AI válaszol..." 
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                       Foreground="#95A5A6" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontStyle="Italic"/>

            <!-- Input Area -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Name="InputTextBox" Padding="12" FontSize="14" VerticalAlignment="Center" 
                         Foreground="#2C3E50" Background="White" BorderBrush="#BDC3C7" BorderThickness="1"
                         Text="{Binding InputMessage, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsLoading, Converter={StaticResource InvertBoolConverter}}"/>
                
                <Button Grid.Column="1" Content="Send" Background="#27AE60" Foreground="White" Padding="20,12" 
                        Margin="10,0,0,0" Command="{Binding SendMessageCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InvertBoolConverter}}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>